# Configuration file for 'hdd-spindown.sh'

# Devices to be monitored
# 	Node names (e.g. 'sda') or ATA-IDs, timeout in seconds
#
#CONF_DEV=( 'sda|3600' \
#			'sdb|3600' ) 

# Hosts to monitor for 'presence' feature
#CONF_HOSTS=( )

# Monitoring interval in seconds
#CONF_INT=300

# Syslog usage
#CONF_SYSLOG=0

# Spinup read length in MiB
#CONF_READLEN=128

# Force SATA device type
#CONF_FORCE_SATA=0

# Use openSeaChest_PowerControl for power state and spindown
# 	auto: Seagate drives only (model 'ST...'), if installed; 1: all drives; 0: never
#CONF_SEACHEST=auto

# Show the power state of the drives above: 'hdd-spindown.sh status'


# vim: ts=4
